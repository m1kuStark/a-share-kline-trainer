{
  "name": "a-share-kline-trainer",
  "private": true,
  "version": "1.3.8",
  "type": "module",
  "main": "desktop/dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:desktop": "concurrently -k \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:desktop:window\"",
    "dev:desktop:window": "node desktop/scripts/dev-window.mjs",
    "build": "npm run typecheck:web && npm run build:server && npm run build:web",
    "build:desktop:main": "tsc -p desktop/tsconfig.json",
    "build:desktop": "npm run typecheck:web && npm run build:server && npm run build:web && npm run build:desktop:main && node desktop/scripts/package-desktop.mjs",
    "test:desktop": "vitest run --config desktop/vitest.config.ts",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node server/dist/index.js",
    "test": "vitest run --config server/vitest.config.ts && npm run test:desktop",
    "test:watch": "vitest --config server/vitest.config.ts",
    "verify:m1": "powershell -ExecutionPolicy Bypass -File scripts/verify-m1.ps1",
    "verify:m2": "npm test && npm run build && npx --no-install tsx scripts/verify-m2.ts",
    "build:journey": "tsx scripts/runtime.ts build-journey",
    "journey": "tsx scripts/runtime.ts journey",
    "agent:dev": "tsx scripts/runtime.ts preview",
    "task": "tsx scripts/worktree.ts",
    "docs:check": "tsx scripts/docs.ts check",
    "docs:impact": "tsx scripts/docs.ts impact",
    "docs:status": "tsx scripts/docs.ts status",
    "workflow:state": "tsx scripts/workflow/state-cli.ts",
    "verify:baseline": "tsx scripts/verify-candidate.ts",
    "verify:candidate": "tsx scripts/verify-candidate.ts",
    "release:windows": "tsx scripts/release/build.mjs",
    "release:desktop": "node desktop/scripts/release-desktop.mjs",
    "release:source": "node scripts/release/export-source.mjs",
    "release:tag": "node scripts/release/tag-release.mjs",
    "verify:fast": "node scripts/verify-fast.mjs",
    "journey:parallel": "node scripts/journey-parallel.mjs",
    "hooks:install": "node scripts/git/install-hooks.mjs",
    "prepare": "node scripts/git/install-hooks.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.8",
    "klinecharts": "10.0.3",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.3",
    "pinyin-pro": "3.29.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.2.5",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/m1kuStark/a-share-kline-trainer.git"
  }
}
